prefix=/usr/local
exec_prefix=/usr/local
libdir=${exec_prefix}/lib
includedir=${prefix}/include

Name: libfolly
Description: Facebook (Folly) C++ library
Version: master
Cflags: -I${includedir}  -std=gnu++1z -DBOOST_CONTEXT_NO_LIB -DBOOST_CONTEXT_DYN_LINK -DBOOST_FILESYSTEM_NO_LIB -DBOOST_FILESYSTEM_DYN_LINK -DBOOST_PROGRAM_OPTIONS_NO_LIB -DBOOST_PROGRAM_OPTIONS_DYN_LINK -DBOOST_REGEX_NO_LIB -DBOOST_REGEX_DYN_LINK -DBOOST_THREAD_NO_LIB -DBOOST_THREAD_DYN_LINK -DGFLAGS_IS_A_DLL=0 -I/usr/include -I/usr/include/libiberty
Libs: -L${libdir} -lfolly
Libs.private: /usr/lib/riscv64-linux-gnu/libdouble-conversion.so /usr/lib/riscv64-linux-gnu/libglog.so /usr/lib/riscv64-linux-gnu/libevent.so /usr/lib/riscv64-linux-gnu/libssl.so /usr/lib/riscv64-linux-gnu/libcrypto.so /usr/lib/riscv64-linux-gnu/libz.so /usr/lib/riscv64-linux-gnu/liblzma.so /usr/lib/riscv64-linux-gnu/liblz4.so /usr/lib/riscv64-linux-gnu/libzstd.so /usr/lib/riscv64-linux-gnu/libsnappy.so /usr/lib/riscv64-linux-gnu/libiberty.a /usr/lib/riscv64-linux-gnu/libsodium.so -ldl
